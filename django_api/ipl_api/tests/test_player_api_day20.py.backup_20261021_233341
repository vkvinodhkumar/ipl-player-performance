from django.test import TestCase

class PlayerApiSmokeTests(TestCase):
    def test_player_list_does_not_return_server_error(self):
        response = self.client.get("/api/players/", HTTP_ACCEPT="application/json")
        self.assertLess(response.status_code, 500, f"Player list returned HTTP {response.status_code}")
        self.assertIn(response.status_code, (200, 400, 401, 403), f"Unexpected HTTP {response.status_code}")

    def test_unknown_player_returns_controlled_response(self):
        response = self.client.get(
            "/api/players/__day20_player_that_does_not_exist__/",
            HTTP_ACCEPT="application/json",
        )
        self.assertLess(response.status_code, 500, f"Unknown player returned HTTP {response.status_code}")
        self.assertIn(response.status_code, (400, 404), f"Expected 400/404, got {response.status_code}")
